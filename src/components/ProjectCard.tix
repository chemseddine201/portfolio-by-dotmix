import type { Project } from "../data/projects.schema.js";
import { PLACEHOLDER_MARK } from "../data/projects.schema.js";

interface ProjectCardProps {
  project: Project;
  index: number;
}

export default function ProjectCard(props: ProjectCardProps) {
  const p = props.project;
  const number = String(props.index + 1).padStart(2, "0");
  const titleId = `project-${p.id}-title`;
  const isReal = (url: string): boolean => url.startsWith("https://") && !url.includes(PLACEHOLDER_MARK);
  const hasDemo = isReal(p.links.demo);
  const hasRepo = isReal(p.links.repo);

  return (
    <article class="panel project-card" id={`project-${p.id}`} aria-labelledby={titleId} data-tilt>
      <span class="card-glare" aria-hidden="true"></span>
      <div class="panel-bar">
        <span class="badge">{number} / {p.id}</span>
      </div>
      <img class="project-image" src={p.image} alt={p.imageAlt} width="800" height="500" loading={props.index === 0 ? "eager" : "lazy"} decoding="async" />
      <div class="project-body">
        <h3 id={titleId} class="project-title">{p.title}</h3>
        <dl class="case-study">
          <div class="cs-row"><dt>Context</dt><dd>{p.caseStudy.context}</dd></div>
          <div class="cs-row"><dt>Role</dt><dd>{p.caseStudy.role}</dd></div>
          <div class="cs-row"><dt>Constraint</dt><dd>{p.caseStudy.constraint}</dd></div>
          <div class="cs-row"><dt>Outcome</dt><dd>{p.caseStudy.outcome}</dd></div>
        </dl>
        <ul class="tech-list" aria-label="Tech stack">
          {each (tech, t) in p.tech}
            <li class="badge tech">{tech}</li>
          {endeach}
        </ul>
        <p class="project-links">
          {if hasDemo}
            <a class="text-link" href={p.links.demo} target="_blank" rel="noopener">Live demo ↗</a>
          {endif}
          {if hasRepo}
            <a class="text-link" href={p.links.repo} target="_blank" rel="noopener">Source ↗</a>
          {endif}
          {if !hasDemo && !hasRepo}
            <span class="badge private-badge">Proprietary · Confidential</span>
          {endif}
        </p>
      </div>
    </article>
  );
}

<style>
  .private-badge {
    color: var(--text-muted);
    border: 1px dashed var(--rule);
    font-size: var(--fs-small);
    padding: 4px 8px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .project-card {
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  .project-card:hover {
    border-color: var(--rule-ui);
  }
  .project-image {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    background: var(--surface-sunk);
    border-bottom: 1px solid var(--rule);
    color: var(--text-muted);
    font-size: var(--fs-small);
  }
  .project-body {
    display: flex;
    flex-direction: column;
    gap: 20px;
    flex: 1;
    padding: 20px;
  }
  .project-title {
    font-size: var(--fs-h3);
    letter-spacing: -0.01em;
    line-height: 1.25;
  }
  .case-study {
    display: grid;
    gap: 12px;
  }
  .cs-row {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: 12px;
  }
  .cs-row dt {
    color: var(--accent);
    font-size: var(--fs-small);
    font-weight: 600;
    padding-top: 2px;
  }
  .cs-row dd {
    font-size: 0.9375rem;
    color: var(--text);
  }
  @media (max-width: 420px) {
    .cs-row {
      grid-template-columns: 1fr;
      gap: 2px;
    }
  }
  .tech-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    padding: 0;
  }
  .tech {
    padding: 6px 8px;
    border: 1px solid var(--rule);
  }
  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 24px;
    margin-top: auto;
  }
</style>
